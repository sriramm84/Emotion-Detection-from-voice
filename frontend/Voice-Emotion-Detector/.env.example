# Copy this file to .env.local and adjust if needed.

# Where the FastAPI backend is running
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Only needed if the backend runs with ENABLE_AUTH=True (must match its API_TOKEN).
# Note: NEXT_PUBLIC_ values are visible in the browser, so use this for local demos only.
NEXT_PUBLIC_API_TOKEN=
